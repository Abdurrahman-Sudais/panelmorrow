# Frontend-safe configuration only. NEVER put AWS access keys or secrets here.
# All AWS calls (SageMaker, Bedrock, S3, DynamoDB) go through the backend API Gateway,
# which authorises requests using Cognito JWTs.
VITE_API_MODE=mock            # mock | live
VITE_API_BASE_URL=https://api.example.com/v1
VITE_COGNITO_REGION=eu-west-2
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# Lead capture (demo request + contact forms). Leave empty and the forms open a pre-filled email instead.
VITE_HUBSPOT_PORTAL_ID=
VITE_HUBSPOT_FORM_GUID=
VITE_HUBSPOT_CONTACT_FORM_GUID=
